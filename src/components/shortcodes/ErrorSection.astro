---
import type { Locale } from '../../config/site';
import { t } from '../../i18n';

interface Props {
	message?: string;
	class?: string;
	locale?: Locale;
}

const { message, class: className, locale = 'fr' } = Astro.props;
const defaultMessage = message ?? t(locale, 'Error404');
---

<div
	class:list={[
		'center-l',
		'box-l',
		'--s2p0',
		'hero',
		'error-section',
		'text-align:center',
		className,
	]}
>
	<h1 class="error-section-message h1">{defaultMessage}</h1>
	<div class="content --s2p0">
		<slot />
	</div>
</div>
