---
interface Props {
	message?: string;
	class?: string;
}

const { message, class: className } = Astro.props;
---

<div
	class:list={[
		'center-l',
		'box-l',
		'--s2p0',
		'hero',
		'error-section',
		'text-align:center',
		className,
	]}
>
	{message && <h1 class="error-section-message h1">{message}</h1>}
	<div class="content --s2p0">
		<slot />
	</div>
</div>
