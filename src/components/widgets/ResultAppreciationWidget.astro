---
import type { Locale } from '../../config/site';
import { t } from '../../i18n';
import Collapse from '../shortcodes/Collapse.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const grades = ['A', 'B', 'C', 'D', 'E', 'F', 'G'] as const;
---

<section class="center-l box-l --s2p0">
	<div class="stack-l with-sidebar-l --s3">
		<div>
			<div class="info_2_columns_col1 stack-l">
				<div>
					<div class="result-badge" data-int-attr="grade" data-int="grade"></div>
				</div>
				<h2 data-int="grade_title"></h2>
				<p class="font-size:1">
					<span set:html={t(locale, 'ResultScore')} />{' '}
					<span>
						<span data-int="score">0</span> / 100
					</span>
				</p>
				<hr class="small" />
				<img
					alt=""
					class="result-screenshot"
					height="800"
					loading="lazy"
					src=""
					width="1422"
				/>
				<div class="info-collapse">
					<Collapse
						label={t(locale, 'ResultScoreExplainationLabel')}
						content={t(locale, 'ResultScoreExplainationContent')}
						knowMore={t(locale, 'ResultScoreExplainationKnowMore')}
						moreHref={t(locale, 'HowDoesItWorksURL')}
						moreLabel={t(locale, 'HowDoesItWorksTitle')}
					/>
				</div>
			</div>
			<div class="info_2_columns_col2 stack-l center-l --s3">
				<div class="result-notation-header">
					<div class="result-notation-message">
						<p data-int="grade_message"></p>
					</div>
				</div>
				<div class="result-notation-content">
					<div class="result-notation-levels">
						<div class="display:flex justify-content:space-between font-style:italic font-size:small">
							<span>max. 100</span>
							<span>min. 0</span>
						</div>
						<div class="result-notation-levels-chart cluster-l --no-margin">
							<div>
								{grades.map((grade) => (
									<div class="notation-level-chart" data-grade-result={grade}>
										<div class="chart-part" />
										<div class="level-chart-label">{grade}</div>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
				<ul class="stack-l --s0 result-notation-info-list">
					<li class="font-weight:bold">
						<span class="result-notation-info-label">{t(locale, 'PageRank')}</span>
						<span class="result-notation-info-number">
							<span data-int="initial_ranking">{t(locale, 'NotAvailable')}</span> /
							<span data-int="initial_total_results">
								{t(locale, 'NotAvailable')}
							</span>
						</span>
					</li>
					<li class="result-notation-info-item">
						<span class="result-notation-info-label" data-int-attr="size_binary_score">
							<span data-int="size_verdict"></span>
						</span>
						<span
							class="result-notation-info-number"
							set:html={t(locale, 'ResultNotationInfoNumberSize')}
						/>
					</li>
					<li class="result-notation-info-item">
						<span class="result-notation-info-label" data-int-attr="nodes_binary_score">
							<span data-int="nodes_verdict"></span>
						</span>
						<span
							class="result-notation-info-number"
							set:html={t(locale, 'ResultNotationInfoNumberNodes')}
						/>
					</li>
					<li class="result-notation-info-item">
						<span
							class="result-notation-info-label"
							data-int-attr="requests_binary_score"
						>
							<span data-int="requests_verdict"></span>
						</span>
						<span
							class="result-notation-info-number"
							set:html={t(locale, 'ResultNotationInfoNumberRequests')}
						/>
					</li>
				</ul>
				<div>
					<a class="content-link" href="#score-details">
						{t(locale, 'SeeScoreDetails')}
						<span>
							<svg aria-hidden="true">
								<use href="#icon-anchor-down"></use>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
