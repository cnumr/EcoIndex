---
import type { Locale } from '../../config/site';
import { buildMenuItems, extraMenu, mainMenu } from '../../config/site';
import { t } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
	locale: Locale;
	currentPath: string;
	decoType?: string;
	alternatePath?: string;
}

const { locale, currentPath, decoType, alternatePath } = Astro.props;
const mainItems = buildMenuItems(locale, mainMenu[locale]);
const extraItems = buildMenuItems(locale, extraMenu[locale]);

function isActive(href: string): boolean {
	if (href === '/' || href === '/en' || href === '/en/') {
		return currentPath === href || currentPath === href.replace(/\/$/, '');
	}
	return currentPath.startsWith(href);
}

const blobCount =
	decoType === 'home' || decoType === 'contribute' || decoType === 'generic'
		? 3
		: decoType === 'loading'
			? 1
			: decoType === '404'
				? 6
				: 0;
const showBurger = decoType === 'home';
---

<div id="dialog-here"></div>

<div class="svg-symbols" aria-hidden="true">
	<span class="inline-svg" set:html={await Astro.slots.render('symbols')} />
</div>

{(blobCount > 0 || showBurger) && (
	<div class={`deco-container deco-type-${decoType}`} aria-hidden="true">
		{Array.from({ length: blobCount }, (_, i) => (
			<div class={`deco-object deco-object--blob-${i + 1}`}>
				<svg class="icon-l" focusable="false">
					<use href="#deco-blob" />
				</svg>
			</div>
		))}
		{showBurger && (
			<div class="deco-object deco-object--burger">
				<svg class="icon-l" focusable="false">
					<use href="#deco-burger" />
				</svg>
			</div>
		)}
	</div>
)}

<div class="header-container shadow-container">
	<header role="banner" class="wrapper">
		<div>
			<a
				href={locale === 'fr' ? '/' : '/en/'}
				class="logo-ecoindex"
				title={`EcoIndex, ${t(locale, 'BackHome')}`}
			>
				<span class="logo-ecoindex__eco">eco</span>
				<span class="logo-ecoindex__index">Index</span>
			</a>
			<div class="menu-btn-container" hidden>
				<div class="with-icon-l">
					<button class="menu-btn" aria-expanded="false" aria-controls="main-nav">
						<svg
							class="icon-l"
							focusable="false"
							viewBox="0 0 30 30"
							stroke="currentColor"
							width="1em"
							height="1em"
						>
							<path d="M3,3 27,3 M3,15 27,15 M3,27 27,27"></path>
						</svg>
						Menu
					</button>
				</div>
			</div>
			<nav
				id="main-nav"
				role="navigation"
				class="main-nav-container"
				data-open="false"
				aria-labelledby="main-nav-label"
			>
				<div>
					<span id="main-nav-label" hidden>
						{t(locale, 'MainNav')}
					</span>
					<div class="cluster-l">
						<ul>
							{mainItems.map((item) => (
								<li>
									{isActive(item.href) ? (
										<span aria-current="page">{item.label}</span>
									) : (
										<a href={item.href}>{item.label}</a>
									)}
								</li>
							))}
						</ul>
					</div>
					<div class="cluster-l">
						<ul>
							{extraItems.map((item) => (
								<li>
									{isActive(item.href) ? (
										<span aria-current="page">{item.label}</span>
									) : (
										<a href={item.href}>{item.label}</a>
									)}
								</li>
							))}
						</ul>
					</div>
					<LanguageSwitcher
						locale={locale}
						currentPath={currentPath}
						alternatePath={alternatePath}
					/>
				</div>
			</nav>
		</div>
	</header>
</div>
