---
import type { Locale } from '../../config/site';
import { t } from '../../i18n';

interface Props {
	locale: Locale;
	currentPath?: string;
	alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr';
---

<nav role="navigation" class="language-switcher">
	{alternatePath ? (
		<>
			<span lang={locale} title={t(locale, locale)} class="lang" aria-current="true">
				<span aria-hidden="true">{locale}</span>
			</span>
			&nbsp;|&nbsp;
			<a
				lang={otherLocale}
				title={t(locale, `SwitchTo_${otherLocale}`)}
				href={alternatePath}
				hreflang={otherLocale}
				class="lang"
			>
				<span aria-hidden="true">{otherLocale}</span>
			</a>
		</>
	) : (
		<span lang={locale} class="lang" aria-current="true">
			<span aria-hidden="true">{locale}</span>
		</span>
	)}
</nav>
